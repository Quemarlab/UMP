APP_ENV=production            # production | local
APP_DEBUG=false
APP_URL=                      # optional, e.g. https://ump.example.com (auto-detected when empty)

# ONE database shared with the website admin: same accounts, roles, 2FA and settings table.
DB_HOST=localhost
DB_NAME=ym
DB_USER=root
DB_PASS=

# Outgoing mail (SMTP) — use the SAME values as the website. Used for invitations, password resets and the daily summary.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl           # ssl | tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Young Masters LTD

# Where the website admin lives (shortcut in the sidebar for people with access there)
YM_URL=                       # e.g. https://youngmasters.rw/ControlPanel
